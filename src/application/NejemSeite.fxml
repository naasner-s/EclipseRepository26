<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.BoxBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="342.0" prefWidth="408.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.NaasnerSeiteController">
   <children>
      <AnchorPane prefHeight="234.0" prefWidth="324.0">
         <children>
            <TextField fx:id="tfText" layoutX="14.0" layoutY="56.0" prefHeight="25.0" prefWidth="244.0" promptText="Naasner war hier" />
            <Label layoutX="31.0" layoutY="14.0" text="mein Rückgabetext ist:" />
         </children>
      </AnchorPane>
      <ImageView fitHeight="176.0" fitWidth="180.0" layoutX="228.0" layoutY="166.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Foto/Unbenannt.jpg" />
         </image>
      </ImageView>
      <Button fx:id="btSchließen" layoutX="359.0" layoutY="2.0" mnemonicParsing="false" onAction="#schließenFenster" text="X" textAlignment="CENTER" textFill="RED">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <effect>
            <BoxBlur iterations="0" width="0.0" />
         </effect>
      </Button>
   </children>
</AnchorPane>
