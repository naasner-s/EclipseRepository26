<AnchorPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.NoamSeiteController">
   <children>
      <AnchorPane prefHeight="234.0" prefWidth="324.0">
