            <TextField fx:id="tfSD" layoutX="137.0" layoutY="18.0" />
            <Button fx:id="btSD" layoutX="234.0" layoutY="43.0" mnemonicParsing="false" onAction="#sliderAnzeige" text="Slider" />
            <ImageView fx:id="iv" fitHeight="47.0" fitWidth="55.0" layoutX="13.0" layoutY="181.0" pickOnBounds="true" preserveRatio="true">
               <image>
